# TFPlot 只读取本目录的 TFPlot/.env。
UPLOAD_File=C:/tfplot-data/uploads
template_file=C:/path/to/TFPlot/Template.csv
Plot_Bokeh=http://127.0.0.1:5006/Plot

# Django 服务根地址，不包含 /WebDatabase 或 /LabDatabase
WebDatabase_URL=http://127.0.0.1:8000

# Assembly 功能必填
Level2_Backbone_Name=replace-with-level2-backbone-name
Level3_Backbone_Name=replace-with-level3-backbone-name

# Django 登录凭据，仅保存在本地 .env 中
username=
password=
# result_file=C:/tfplot-data/output/Level3.gb
UPLOAD_TASK_TTL_SECONDS=86400
UPLOAD_MAX_FILES=20
UPLOAD_MAX_REQUEST_BYTES=52428800
TPLOT_PORT=8101
FLASK_DEBUG=false
